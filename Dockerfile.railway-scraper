# DupeFinder Scraper Worker — Railway (Playwright/Chromium)
#
# Railway should use:
# - Root Directory: .  (repo root)
# - Dockerfile path: Dockerfile.railway-scraper
#
# This service is intentionally separate from `Dockerfile.railway-api` to keep the API/ML
# image under Railway's image size limits.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8010 \
    PROJECT_ROOT=/app

WORKDIR /app

# Playwright's install-deps path needs apt tooling + browser libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
  && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-scraper.txt /app/backend/requirements-scraper.txt

RUN python -m pip install --upgrade pip setuptools wheel \
  && pip install --no-cache-dir -r /app/backend/requirements-scraper.txt \
  && python -m playwright install --with-deps chromium

# Copy only backend code (scraper imports `app.*`)
COPY backend /app/backend

WORKDIR /app/backend

EXPOSE 8010

CMD ["sh", "-c", "uvicorn app.scraper_worker_app:app --host 0.0.0.0 --port ${PORT:-8010}"]
