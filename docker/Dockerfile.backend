# DEPRECATED (kept for historical reference)
#
# Use the monorepo-aware production Dockerfile at repo root:
#   `Dockerfile.railway-api`
#
# The old layout assumed `docker build` from repo root and used `COPY backend/...`,
# but it also pointed `uvicorn` at `main:app` (not `app.main:app`) and enabled `--reload`,
# which is not appropriate for production.

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ .

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

