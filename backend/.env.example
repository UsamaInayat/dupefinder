# Copy to `.env` for local runs. Do not commit `.env` with real secrets.

# --- Gmail API (Railway-friendly: HTTPS, no SMTP; OTP to any address, no custom domain) ---
# When all three are set, they take priority over Resend and SMTP.
# GCP: enable Gmail API, OAuth consent, create OAuth client (Web). Then use OAuth Playground
# (use your own OAuth credentials) with scope https://www.googleapis.com/auth/gmail.send
# to obtain a refresh token. EMAIL_FROM / SMTP_USERNAME must be the same Gmail account.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=

# --- Resend (recommended on Railway: HTTPS, no SMTP to Gmail) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Required for signup to arbitrary addresses: verify a domain at resend.com/domains, then e.g.
#   RESEND_FROM=DupeFinder <noreply@yourdomain.com>
# If unset with Gmail EMAIL_FROM, the app uses onboarding@resend.dev — Resend then only
# allows sending TO your Resend account email, not random signups.
RESEND_FROM=

# --- SMTP (used only when RESEND_API_KEY is empty) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=DupeFinder
