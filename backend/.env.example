# Copy to `.env` for local runs. Do not commit `.env` with real secrets.

# --- Resend (recommended on Railway: HTTPS, no SMTP to Gmail) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# From address must be allowed in Resend: either verify your domain and use e.g.
#   RESEND_FROM=DupeFinder <noreply@yourdomain.com>
# or leave unset with EMAIL_FROM still on Gmail — the app will use onboarding@resend.dev
# (fine for quick tests; verify a domain for production signups).
RESEND_FROM=

# --- SMTP (used only when RESEND_API_KEY is empty) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=DupeFinder
